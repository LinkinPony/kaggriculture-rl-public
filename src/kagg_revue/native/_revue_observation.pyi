from typing import Any

import numpy as np
import numpy.typing as npt

feature_version: str

class ContractSession:
    def __init__(self, configuration: dict[str, Any], units: int) -> None: ...
    def update(self, observation: dict[str, Any]) -> None: ...
    def observe_into(self, output: npt.NDArray[np.float16]) -> None: ...
    def set_program(
        self, plan: npt.NDArray[np.int64], capacity: int, quantities: list[int]
    ) -> None: ...
    def program_action(self) -> dict[str, Any]: ...
